# Copy to .env. These are demo values; change every secret outside a demo.

POSTGRES_USER=sogukzincir
POSTGRES_PASSWORD=sogukzincir-demo
POSTGRES_DB=sogukzincir
DATABASE_URL=postgres://sogukzincir:sogukzincir-demo@db:5432/sogukzincir?sslmode=disable

# >= 32 bytes, signs access tokens
JWT_SECRET=change-me-demo-jwt-secret-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# 64 hex chars (32 bytes): encrypts device HMAC keys at rest (AES-256-GCM)
DEVICE_KEY_ENC_KEY=4f1c2a9d7e3b5c6a8d9e0f1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e
# shared by seed and simulator to derive per-device keys (demo provisioning)
DEVICE_PROVISION_SECRET=change-me-demo-provisioning-secret
DEVICE_SIGNATURE_SKEW=2m

# deterministic demo data: same SEED -> same data
SEED=42
SENSOR_COUNT=2000
BACKFILL_HOURS=24

RAW_RETENTION=168h
EVAL_INTERVAL=30s
ESCALATE_AFTER=10m
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
